import { Button } from "std-widgets.slint";
import { Theme, GroceryItemData, GroceryListInfo } from "theme.slint";
import { ListsScreen } from "lists_screen.slint";
import { DetailScreen } from "detail_screen.slint";
import { InStoreScreen } from "in_store_screen.slint";
import { ShareJoinScreen } from "share_join_screen.slint";
import { SettingsScreen } from "settings_screen.slint";

export { GroceryItemData, GroceryListInfo }

export component AppWindow inherits Window {
    title: "Groshe";
    min_width: 360px;
    min_height: 640px;
    preferred_width: 412px;
    preferred_height: 840px;
    background: root.dark_mode ? Theme.dark_bg : Theme.light_bg;

    // State properties
    in-out property <bool> dark_mode: true;
    in-out property <int> active_tab: 0; // 0: Lists, 1: Detail, 2: InStore, 3: Share, 4: Settings
    in-out property <string> active_list_id: "";
    in-out property <string> active_list_title: "My Groceries";
    in-out property <string> ticket_str: "";
    in-out property <string> qr_ascii: "";
    in-out property <bool> show_undo_toast: false;
    in-out property <string> undo_toast_message: "";
    in-out property <bool> show_export_status: false;
    in-out property <string> export_status_message: "";

    // Device / Network state
    in-out property <string> author_id: "author-local";
    in-out property <string> node_id: "node-local";
    in-out property <int> peer_count: 0;
    in-out property <string> relay_status: "Connected";

    // Data models
    in property <[GroceryListInfo]> lists: [];
    in-out property <[GroceryItemData]> items: [];
    in property <[string]> frequent_suggestions: [];

    // Callbacks to Rust runtime
    callback select_list(string /* id */, string /* title */);
    callback create_list(string /* title */);
    callback delete_list(string /* id */);
    callback rotate_list(string /* id */);
    callback share_list(string /* id */);
    callback toggle_item_check(string /* id */);
    callback delete_item(string /* id */);
    callback edit_item(string /* id */, string /* raw_input */);
    callback move_item_up(string /* id */);
    callback move_item_down(string /* id */);
    callback add_item(string /* raw_input */);
    callback trigger_undo();
    callback copy_ticket();
    callback join_ticket(string /* ticket */);
    callback prune_tombstones();
    callback export_active_list();
    callback export_json_backup();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Top App Bar (Hidden in In-Store mode to maximize shopping screen space)
        if root.active_tab != 2 : Rectangle {
            height: 60px;
            background: root.dark_mode ? Theme.dark_surface : Theme.light_surface;

            HorizontalLayout {
                padding_left: 16px;
                padding_right: 16px;
                alignment: space_between;

                // Leading: Back button if in Detail or Share tab, else App title
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    if root.active_tab == 1 || root.active_tab == 3 : Rectangle {
                        width: 36px;
                        height: 36px;
                        y: 12px;
                        border_radius: 18px;
                        background: root.dark_mode ? #2a2a2a : #e0e0e0;

                        TouchArea {
                            accessible_role: button;
                            accessible_label: "Go back to lists";
                            clicked => { root.active_tab = 0; }
                        }

                        Text {
                            text: "←";
                            font_size: 18px;
                            font_weight: 700;
                            color: root.dark_mode ? Theme.dark_text : Theme.light_text;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                    }

                    Text {
                        text: root.active_tab == 0 ? "Groshe" :
                              root.active_tab == 1 ? root.active_list_title :
                              root.active_tab == 3 ? "Share & Join" : "Settings";
                        font_size: 20px;
                        font_weight: 700;
                        color: root.dark_mode ? Theme.dark_text : Theme.light_text;
                        vertical_alignment: center;
                    }
                }

                // Trailing actions: In-store mode quick trigger or dark mode toggle
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    if root.active_tab == 1 : Rectangle {
                        width: 44px;
                        height: 44px;
                        y: 8px;
                        border_radius: 22px;
                        background: Theme.primary;

                        TouchArea {
                            accessible_role: button;
                            accessible_label: "Start in-store shopping mode";
                            clicked => { root.active_tab = 2; }
                        }

                        Text {
                            text: "🛒";
                            font_size: 18px;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                    }
                }
            }
        }

        // Main Screen View Router
        Rectangle {
            vertical_stretch: 1;

            if root.active_tab == 0 : ListsScreen {
                dark_mode: root.dark_mode;
                lists: root.lists;
                select_list(id, title) => {
                    root.active_list_id = id;
                    root.active_list_title = title;
                    root.active_tab = 1;
                    root.select_list(id, title);
                }
                create_list(title) => { root.create_list(title); }
                share_list(id) => {
                    root.active_list_id = id;
                    root.active_tab = 3;
                    root.share_list(id);
                }
                delete_list(id) => { root.delete_list(id); }
                rotate_list(id) => { root.rotate_list(id); }
            }

            if root.active_tab == 1 : DetailScreen {
                dark_mode: root.dark_mode;
                list_title: root.active_list_title;
                items: root.items;
                frequent_suggestions: root.frequent_suggestions;
                show_undo_toast: root.show_undo_toast;
                undo_toast_message: root.undo_toast_message;
                toggle_item_check(id) => { root.toggle_item_check(id); }
                delete_item(id) => { root.delete_item(id); }
                edit_item(id, input) => { root.edit_item(id, input); }
                move_item_up(id) => { root.move_item_up(id); }
                move_item_down(id) => { root.move_item_down(id); }
                add_item(input) => { root.add_item(input); }
                trigger_undo() => { root.trigger_undo(); }
                start_in_store_mode() => { root.active_tab = 2; }
            }

            if root.active_tab == 2 : InStoreScreen {
                dark_mode: root.dark_mode;
                list_title: root.active_list_title;
                items: root.items;
                toggle_item_check(id) => { root.toggle_item_check(id); }
                exit_in_store_mode() => { root.active_tab = 1; }
                finish_shopping() => { root.active_tab = 1; }
            }

            if root.active_tab == 3 : ShareJoinScreen {
                dark_mode: root.dark_mode;
                active_list_title: root.active_list_title;
                ticket_str: root.ticket_str;
                qr_ascii: root.qr_ascii;
                copy_ticket() => { root.copy_ticket(); }
                join_ticket(ticket) => { root.join_ticket(ticket); }
            }

            if root.active_tab == 4 : SettingsScreen {
                dark_mode: root.dark_mode;
                author_id: root.author_id;
                node_id: root.node_id;
                peer_count: root.peer_count;
                relay_status: root.relay_status;
                show_export_status: root.show_export_status;
                export_status_message: root.export_status_message;
                toggle_dark_mode() => { root.dark_mode = !root.dark_mode; }
                prune_tombstones() => { root.prune_tombstones(); }
                export_active_list() => { root.export_active_list(); }
                export_json_backup() => { root.export_json_backup(); }
            }
        }

        // Bottom Navigation Bar (Hidden in In-Store shopping mode)
        if root.active_tab != 2 : Rectangle {
            height: 64px;
            background: root.dark_mode ? Theme.dark_surface : Theme.light_surface;

            HorizontalLayout {
                padding_left: 8px;
                padding_right: 8px;
                alignment: space_around;

                // Tab 0: Lists
                Rectangle {
                    width: 72px;
                    height: 54px;
                    border_radius: 8px;
                    background: root.active_tab == 0 ? (root.dark_mode ? #2a2a2a : #e8f5e9) : #00000000;

                    TouchArea {
                        accessible_role: button;
                        accessible_label: "Lists tab";
                        clicked => { root.active_tab = 0; }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "📋";
                            font_size: 18px;
                            horizontal_alignment: center;
                        }
                        Text {
                            text: "Lists";
                            font_size: 11px;
                            font_weight: root.active_tab == 0 ? 700 : 500;
                            color: root.active_tab == 0 ? Theme.primary_light : (root.dark_mode ? #888888 : #666666);
                            horizontal_alignment: center;
                        }
                    }
                }

                // Tab 1: Current List
                Rectangle {
                    width: 72px;
                    height: 54px;
                    border_radius: 8px;
                    background: root.active_tab == 1 ? (root.dark_mode ? #2a2a2a : #e8f5e9) : #00000000;

                    TouchArea {
                        accessible_role: button;
                        accessible_label: "Detail tab";
                        clicked => { root.active_tab = 1; }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "🛒";
                            font_size: 18px;
                            horizontal_alignment: center;
                        }
                        Text {
                            text: "Items";
                            font_size: 11px;
                            font_weight: root.active_tab == 1 ? 700 : 500;
                            color: root.active_tab == 1 ? Theme.primary_light : (root.dark_mode ? #888888 : #666666);
                            horizontal_alignment: center;
                        }
                    }
                }

                // Tab 3: Share
                Rectangle {
                    width: 72px;
                    height: 54px;
                    border_radius: 8px;
                    background: root.active_tab == 3 ? (root.dark_mode ? #2a2a2a : #e8f5e9) : #00000000;

                    TouchArea {
                        accessible_role: button;
                        accessible_label: "Share tab";
                        clicked => { root.active_tab = 3; }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "🔗";
                            font_size: 18px;
                            horizontal_alignment: center;
                        }
                        Text {
                            text: "Share";
                            font_size: 11px;
                            font_weight: root.active_tab == 3 ? 700 : 500;
                            color: root.active_tab == 3 ? Theme.primary_light : (root.dark_mode ? #888888 : #666666);
                            horizontal_alignment: center;
                        }
                    }
                }

                // Tab 4: Settings
                Rectangle {
                    width: 72px;
                    height: 54px;
                    border_radius: 8px;
                    background: root.active_tab == 4 ? (root.dark_mode ? #2a2a2a : #e8f5e9) : #00000000;

                    TouchArea {
                        accessible_role: button;
                        accessible_label: "Settings tab";
                        clicked => { root.active_tab = 4; }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "⚙️";
                            font_size: 18px;
                            horizontal_alignment: center;
                        }
                        Text {
                            text: "Settings";
                            font_size: 11px;
                            font_weight: root.active_tab == 4 ? 700 : 500;
                            color: root.active_tab == 4 ? Theme.primary_light : (root.dark_mode ? #888888 : #666666);
                            horizontal_alignment: center;
                        }
                    }
                }
            }
        }
    }
}
